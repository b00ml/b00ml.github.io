---
import { isExternalProjectLink, type ProjectCardItem } from '@/lib/projects/cards'
import { STATUS_LABELS } from '@/lib/projects/status'

interface Props {
  project: ProjectCardItem
  headingTag?: 'h2' | 'h3'
}

const { project, headingTag: Heading = 'h3' } = Astro.props
const metaLine = [project.period, project.role].filter(Boolean).join(' · ')
---

<article
  class='group flex h-full min-w-0 flex-col justify-between gap-4 rounded-xl border border-border bg-card p-5 text-card-foreground transition hover:border-foreground/20 hover:shadow-sm'
>
  <a
    href={project.href}
    data-astro-prefetch
    class='flex flex-1 flex-col gap-3 rounded-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring'
  >
    <div class='flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-muted-foreground'>
      <span
        class:list={[
          'rounded-md px-2 py-0.5 font-medium',
          project.status === 'ongoing' ? 'bg-primary/10 text-primary' : 'bg-muted text-foreground'
        ]}
      >
        {STATUS_LABELS[project.status]}
      </span>
      {metaLine && <span>{metaLine}</span>}
      {project.partCount > 0 && <span>· {project.partCount + 1} 篇</span>}
    </div>

    <Heading
      class='text-lg font-semibold leading-snug text-foreground transition-colors group-hover:text-primary'
    >
      {project.title}
    </Heading>

    <p class='text-sm leading-6 text-muted-foreground'>{project.summary}</p>

    {
      project.highlights.length > 0 && (
        <ul class='flex flex-col gap-1.5 border-l-2 border-primary/25 pl-3 text-xs leading-5 text-foreground/90'>
          {project.highlights.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      )
    }

    {
      project.stack.length > 0 && (
        <div class='mt-auto flex flex-wrap gap-1.5 pt-1 text-xs text-muted-foreground'>
          {project.stack.map((item) => (
            <span class='rounded-md border border-border bg-muted/40 px-2 py-0.5'>{item}</span>
          ))}
        </div>
      )
    }
  </a>

  {
    project.links.length > 0 && (
      <div class='flex flex-wrap items-center gap-2 border-t border-border pt-3 text-xs'>
        {project.links.map((link) => {
          const external = isExternalProjectLink(link.href)
          return (
            <a
              href={link.href}
              target={external ? '_blank' : undefined}
              rel={external ? 'noopener noreferrer' : undefined}
              class='inline-flex items-center gap-1 rounded-md border border-border bg-background px-2.5 py-1 font-medium text-muted-foreground transition hover:border-foreground/20 hover:bg-muted hover:text-foreground'
            >
              <span>{link.label}</span>
              <span aria-hidden='true'>{external ? '↗' : '→'}</span>
            </a>
          )
        })}
      </div>
    )
  }
</article>
