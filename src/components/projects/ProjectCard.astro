---
import { isExternalProjectLink, projectLinkKind, type ProjectCardItem } from '@/lib/projects/cards'
import { STATUS_LABELS } from '@/lib/projects/status'

interface Props {
  project: ProjectCardItem
  headingTag?: 'h2' | 'h3'
}

const { project, headingTag: Heading = 'h3' } = Astro.props
const metaLine = [project.period, project.role].filter(Boolean).join(' · ')
---

<article
  class='group flex h-full min-w-0 flex-col justify-between gap-4 rounded-xl border border-border bg-card p-5 text-card-foreground transition hover:border-foreground/20 hover:shadow-sm'
>
  <a
    href={project.href}
    data-astro-prefetch
    class='flex flex-1 flex-col gap-3 rounded-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring'
  >
    <div class='flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-muted-foreground'>
      <span
        class:list={[
          'rounded-md px-2 py-0.5 font-medium',
          project.status === 'ongoing' ? 'bg-primary/10 text-primary' : 'bg-muted text-foreground'
        ]}
      >
        {STATUS_LABELS[project.status]}
      </span>
      {metaLine && <span>{metaLine}</span>}
      {project.partCount > 0 && <span>· {project.partCount + 1} 篇</span>}
    </div>

    <Heading
      class='text-lg font-semibold leading-snug text-foreground transition-colors group-hover:text-primary'
    >
      {project.title}
    </Heading>

    <p class='text-sm leading-6 text-muted-foreground'>{project.summary}</p>

    {
      project.highlights.length > 0 && (
        <ul class='flex flex-col gap-1.5 border-l-2 border-primary/25 pl-3 text-xs leading-5 text-foreground/90'>
          {project.highlights.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      )
    }

    {
      project.stack.length > 0 && (
        <div class='mt-auto flex flex-wrap gap-1.5 pt-1 text-xs text-muted-foreground'>
          {project.stack.map((item) => (
            <span class='rounded-md border border-border bg-muted/40 px-2 py-0.5'>{item}</span>
          ))}
        </div>
      )
    }
  </a>

  {
    project.links.length > 0 && (
      <div class='flex flex-wrap items-center gap-2 border-t border-border pt-3 text-xs'>
        {project.links.map((link) => {
          const external = isExternalProjectLink(link.href)
          const kind = projectLinkKind(link)
          return (
            <a
              href={link.href}
              target={external ? '_blank' : undefined}
              rel={external ? 'noopener noreferrer' : undefined}
              class:list={[
                'proj-action inline-flex items-center gap-1 rounded-md border px-2.5 py-1 font-medium transition',
                `proj-action--${kind}`
              ]}
            >
              <span>{link.label}</span>
              <span aria-hidden='true'>{external ? '↗' : '→'}</span>
            </a>
          )
        })}
      </div>
    )
  }
</article>

<style>
  .proj-action--demo {
    background-color: hsl(var(--primary));
    border-color: hsl(var(--primary));
    color: hsl(var(--primary-foreground));
    box-shadow: 0 1px 2px hsl(var(--foreground) / 0.08);
  }
  .proj-action--demo:hover {
    background-color: hsl(var(--primary) / 0.88);
    color: hsl(var(--primary-foreground));
  }

  .proj-action--product {
    background-color: hsl(var(--primary) / 0.1);
    border-color: hsl(var(--primary) / 0.35);
    color: hsl(var(--primary));
  }
  .proj-action--product:hover {
    background-color: hsl(var(--primary) / 0.18);
    border-color: hsl(var(--primary) / 0.55);
    color: hsl(var(--primary));
  }

  .proj-action--diagram {
    background-color: hsl(38 88% 46% / 0.1);
    border-color: hsl(36 80% 42% / 0.34);
    color: hsl(34 86% 29%);
  }
  .proj-action--diagram:hover {
    background-color: hsl(38 88% 46% / 0.18);
    border-color: hsl(36 80% 42% / 0.55);
    color: hsl(34 90% 24%);
  }
  :global(.dark) .proj-action--diagram {
    background-color: hsl(40 92% 64% / 0.12);
    border-color: hsl(40 92% 64% / 0.35);
    color: hsl(42 94% 76%);
  }
  :global(.dark) .proj-action--diagram:hover {
    background-color: hsl(40 92% 64% / 0.2);
    border-color: hsl(40 92% 64% / 0.55);
    color: hsl(42 96% 84%);
  }

  .proj-action--repo {
    background-color: hsl(156 54% 36% / 0.09);
    border-color: hsl(156 50% 34% / 0.32);
    color: hsl(158 60% 25%);
  }
  .proj-action--repo:hover {
    background-color: hsl(156 54% 36% / 0.17);
    border-color: hsl(156 50% 34% / 0.52);
    color: hsl(158 64% 20%);
  }
  :global(.dark) .proj-action--repo {
    background-color: hsl(152 62% 62% / 0.12);
    border-color: hsl(152 62% 62% / 0.34);
    color: hsl(152 68% 76%);
  }
  :global(.dark) .proj-action--repo:hover {
    background-color: hsl(152 62% 62% / 0.2);
    border-color: hsl(152 62% 62% / 0.54);
    color: hsl(152 74% 84%);
  }

  .proj-action--default {
    background-color: hsl(var(--background));
    border-color: hsl(var(--border));
    color: hsl(var(--muted-foreground));
  }
  .proj-action--default:hover {
    background-color: hsl(var(--muted));
    border-color: hsl(var(--foreground) / 0.2);
    color: hsl(var(--foreground));
  }
</style>
