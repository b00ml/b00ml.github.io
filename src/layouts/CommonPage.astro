---
import type { MarkdownHeading } from 'astro'

import PageLayout from '@/layouts/ContentLayout.astro'
import TableOfContents from '@/components/navigation/TableOfContents.astro'
import { filterTocHeadings } from '@/components/navigation/toc'

interface Props {
  title: string
  headings?: MarkdownHeading[]
}

const { title, headings, ...props } = Astro.props
const tocHeadings = filterTocHeadings(headings)
---

<PageLayout meta={{ title }} {...props}>
  {!!tocHeadings.length && <TableOfContents headings={tocHeadings} slot='sidebar' />}

  <Fragment slot='header'>
    <h1 class='text-2xl font-medium sm:mb-2 sm:text-3xl'>
      {title}
    </h1>
  </Fragment>

  <slot />

  <slot name='bottom' slot='bottom' />

  <slot name='bottom-sidebar' slot='bottom-sidebar' />
</PageLayout>
