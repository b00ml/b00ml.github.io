---
import type { MarkdownHeading } from 'astro'
import type { CollectionEntry } from 'astro:content'
import { contentLastModified } from '@/lib/seo/lastmod'

// Plugin styles
import 'katex/dist/katex.min.css'

import ArticleBottom from '@/components/pure/ArticleBottom.astro'
import Hero from '@/components/pure/Hero.astro'
import MediumZoom from '@/components/MediumZoom.astro'
import PageLayout from '@/layouts/ContentLayout.astro'
import JsonLd from '@/components/JsonLd.astro'
import TableOfContents from '@/components/navigation/TableOfContents.astro'
import { integ } from '@/site-config'

interface Props {
  post: CollectionEntry<'blog'>
  posts: CollectionEntry<'blog'>[]
  headings: MarkdownHeading[]
  remarkPluginFrontmatter: Record<string, unknown>
  back?: string
  recommend?: boolean
}

const {
  post: { id, data },
  posts,
  headings,
  remarkPluginFrontmatter,
  back = '/blog',
  recommend = true
} = Astro.props

const { description, pubDate, title, updatedDate } = data

const coverSrc = typeof data.cover?.src === 'string' ? data.cover.src : data.cover?.src.src
const socialImage = coverSrc
const articleDate = pubDate.toISOString()
const articleModified = contentLastModified(Astro.props.post.filePath, pubDate, updatedDate)

const tocHeadings = headings.filter(({ depth }) => depth <= 3)

// Structured data：BlogPosting + 面包屑；author/publisher 引用 BaseHead 里全站输出的 Person
const lang = 'zh-CN'
const origin = Astro.site!.origin
const pageUrl = new URL(Astro.url.pathname, Astro.site).href
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${pageUrl}#article`,
  mainEntityOfPage: pageUrl,
  headline: title,
  description,
  inLanguage: lang,
  datePublished: pubDate.toISOString(),
  dateModified: articleModified,
  ...(socialImage ? { image: new URL(socialImage, Astro.site).href } : {}),
  ...(data.tags.length ? { keywords: data.tags } : {}),
  author: { '@id': `${origin}/#person` },
  publisher: { '@id': `${origin}/#person` },
  isPartOf: { '@id': `${origin}/#website` }
}
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首页', item: `${origin}/` },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${origin}/blog` },
    { '@type': 'ListItem', position: 3, name: title }
  ]
}
---

<PageLayout
  meta={{
    noindex: data.draft,
    articleDate,
    articleModified,
    description,
    ogImage: socialImage,
    title
  }}
  back={back}
>
  <JsonLd schema={[articleLd, breadcrumbLd]} />
  {!!tocHeadings.length && <TableOfContents headings={tocHeadings} slot='sidebar' />}

  <Hero {data} {remarkPluginFrontmatter} slot='header' />

  <div data-pagefind-body>
    <slot />
  </div>

  <Fragment slot='bottom'>
    {/* Article recommend */}
    {
      recommend && (
        <ArticleBottom
          collections={posts.filter((post) => !post.data.draft)}
          {id}
          class='mt-3 sm:mt-6'
        />
      )
    }
  </Fragment>

  <slot name='bottom-sidebar' slot='bottom-sidebar' />
</PageLayout>

{integ.mediumZoom.enable && <MediumZoom />}
