---
/**
 * Product Module - /product
 * Product thinking: teardowns, requirements, and design trade-offs. Length is not
 * the point here — the topic is.
 */
import type { GetStaticPaths, Page } from 'astro'
import type { CollectionEntry } from 'astro:content'
import { getCollection } from 'astro:content'
import { listingMetadata } from '@/lib/seo/metadata'

import { Button, Icon } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import Paginator from '@/components/pure/Paginator.astro'

export const prerender = true

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const allEntries = await getCollection('product')
  const sorted = allEntries
    .filter((entry) => !entry.data.draft)
    .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())

  return paginate(sorted, {
    pageSize: 20
  })
}

interface Props {
  page: Page<CollectionEntry<'product'>>
}

const { page } = Astro.props as unknown as Props

const allEntries = (await getCollection('product')).filter((entry) => !entry.data.draft)
const tagCounts = allEntries.reduce(
  (acc, entry) => {
    entry.data.tags.forEach((tag) => {
      acc[tag] = (acc[tag] || 0) + 1
    })
    return acc
  },
  {} as Record<string, number>
)
const uniqueTags = Object.entries(tagCounts)
  .sort(([tagA, countA], [tagB, countB]) =>
    countB !== countA ? countB - countA : tagA.localeCompare(tagB, 'zh-CN')
  )
  .map(([tag]) => tag)

const meta = listingMetadata(
  'product',
  page.currentPage,
  page.data.map((entry) => entry.data.title)
)

const paginationProps = {
  ...(page.url.prev && {
    prevUrl: {
      text: '← 上一页',
      url: page.url.prev
    }
  }),
  ...(page.url.next && {
    nextUrl: {
      text: '下一页 →',
      url: page.url.next
    }
  })
}
---

<PageLayout {meta}>
  <Button title='Back' href='/' style='back' />

  <main class='mt-6 lg:mt-10'>
    <div id='content-header' class='animate'>
      <div class='mb-3 flex items-center gap-3'>
        <div class='rounded-lg bg-muted/50 p-3'>
          <span class='text-2xl'>🧩</span>
        </div>
        <div>
          <h1 class='text-3xl font-medium'>Product</h1>
          <p class='text-sm text-muted-foreground'>产品拆解 · 需求 · 设计取舍</p>
        </div>
      </div>
      <p class='max-w-3xl text-muted-foreground'>
        这里放产品方向的内容：拆解一个产品为什么这么做、一个需求该怎么切、以及设计上的取舍。
        长短不论，主题是产品。
      </p>
    </div>

    {
      page.data.length === 0 ? (
        <p class='mt-8'>还没有产品笔记。</p>
      ) : (
        <div class='mt-10 grid gap-y-16 sm:grid-cols-[3fr_1fr] sm:gap-x-8'>
          <section id='content' class='animate' aria-label='Product entries'>
            <div class='mb-3 flex flex-col justify-between text-sm text-muted-foreground sm:mb-5 sm:flex-row'>
              <span>
                显示第 {page.start + 1}-{page.end + 1} 条，共 {page.total} 条
              </span>
              {page.lastPage > 1 && (
                <span>
                  第 {page.currentPage} / {page.lastPage} 页
                </span>
              )}
            </div>

            <ul class='flex flex-col gap-y-4 text-start'>
              {page.data.map((entry) => (
                <li class='rounded-xl border border-border bg-card px-5 py-5 transition hover:border-foreground/20 hover:shadow-sm'>
                  <a
                    href={`/product/${entry.id}`}
                    class='group/link block space-y-2'
                    data-astro-prefetch
                  >
                    <h3 class='text-lg font-medium leading-tight text-foreground transition-colors group-hover/link:text-primary'>
                      {entry.data.title}
                    </h3>
                    {entry.data.description && (
                      <p class='text-sm leading-6 text-muted-foreground'>
                        {entry.data.description}
                      </p>
                    )}

                    <div class='flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-muted-foreground'>
                      <time datetime={entry.data.pubDate.toISOString()}>
                        {entry.data.pubDate.toLocaleDateString('zh-CN', {
                          year: 'numeric',
                          month: 'short',
                          day: 'numeric'
                        })}
                      </time>
                      {entry.data.updatedDate && (
                        <span>
                          · 更新于{' '}
                          {entry.data.updatedDate.toLocaleDateString('zh-CN', {
                            month: 'short',
                            day: 'numeric'
                          })}
                        </span>
                      )}
                    </div>
                  </a>
                  {entry.data.tags.length > 0 && (
                    <ul class='mt-3 flex flex-wrap gap-1.5'>
                      {entry.data.tags.map((tag: string) => (
                        <li>
                          <a
                            href={`/product/tags/${tag}`}
                            class='inline-flex items-center rounded-full border border-border bg-muted/60 px-2.5 py-0.5 text-xs text-muted-foreground transition hover:border-foreground/25 hover:bg-muted hover:text-foreground'
                            data-astro-prefetch
                          >
                            {tag}
                          </a>
                        </li>
                      ))}
                    </ul>
                  )}
                </li>
              ))}
            </ul>

            {page.lastPage > 1 && (
              <div class='mt-8'>
                <Paginator {...paginationProps} />
              </div>
            )}
          </section>

          {!!uniqueTags.length && (
            <aside class='animate' id='sidebar'>
              <h2 class='mb-4 flex items-center text-lg font-semibold'>
                <Icon name='tag-2' class='me-2' />
                标签
              </h2>
              <ul class='flex flex-wrap gap-2'>
                {uniqueTags.map((tag) => (
                  <li>
                    <a
                      href={`/product/tags/${tag}`}
                      class='inline-flex items-center rounded-full border border-border bg-muted/60 px-2.5 py-1 text-xs text-muted-foreground transition hover:border-foreground/25 hover:bg-muted hover:text-foreground'
                      data-astro-prefetch
                    >
                      {tag}
                    </a>
                  </li>
                ))}
              </ul>
              <span class='mt-4 block sm:text-end'>
                <a
                  aria-label='查看全部标签'
                  href='/product/tags'
                  class='text-sm text-muted-foreground transition hover:text-foreground'
                  data-astro-prefetch
                >
                  查看全部标签 →
                </a>
              </span>
            </aside>
          )}
        </div>
      )
    }
  </main>
</PageLayout>
