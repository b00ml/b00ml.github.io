---
import { getCollection } from 'astro:content'
import { buildHomeViewModel } from '@/lib/curation/home'
import { sectionMetadata } from '@/lib/seo/metadata'

import PageLayout from '@/layouts/BaseLayout.astro'
import HomeLanding from '@/components/home/HomeLanding.astro'
import config from '@/site-config'

export const prerender = true

const [projects, blog, product, notes] = await Promise.all([
  getCollection('projects'),
  getCollection('blog'),
  getCollection('product'),
  getCollection('notes')
])

const viewModel = buildHomeViewModel({
  projects,
  blog,
  product,
  notes,
  isProd: import.meta.env.PROD
})

const meta = sectionMetadata('/') ?? {
  title: '首页',
  description: config.description
}
---

<PageLayout {meta}>
  <HomeLanding {viewModel} />
</PageLayout>
