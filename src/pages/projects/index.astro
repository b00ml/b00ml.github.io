---
import { getCollection } from 'astro:content'
import { buildProjectCards } from '@/lib/projects/cards'
import { STATUS_LABELS, STATUS_NOTE, STATUS_ORDER, type ProjectStatus } from '@/lib/projects/status'
import { sectionMetadata } from '@/lib/seo/metadata'

import { Button } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import ProjectCard from '@/components/projects/ProjectCard.astro'

/**
 * Projects - /projects
 * Artefacts rather than posts: one card per thing that was built, grouped by the
 * state it is in. The point of the page is not to look busy but to let a reader
 * decide, in two lines, whether this project is worth opening.
 */
export const prerender = true

const cards = buildProjectCards(await getCollection('projects'), {
  isProd: import.meta.env.PROD
})

const groups = STATUS_ORDER.map((status) => ({
  status,
  note: STATUS_NOTE[status],
  cards: cards.filter((card) => card.status === status)
})).filter((group) => group.cards.length > 0)

const meta: { title: string; description: string } = sectionMetadata('/projects') ?? {
  title: '项目',
  description: 'peik1 做过的项目。'
}
---

<PageLayout {meta}>
  <Button title='返回' href='/' style='back' />

  <main class='mt-6 lg:mt-10'>
    <div id='content-header' class='animate'>
      <div class='mb-3 flex items-center gap-3'>
        <div class='rounded-lg bg-muted/50 p-3'>
          <span class='text-2xl'>🗂️</span>
        </div>
        <div>
          <h1 class='text-3xl font-medium'>项目</h1>
          <p class='text-sm text-muted-foreground'>做过的、还在做的，以及它们的卡点</p>
        </div>
      </div>
      <p class='max-w-3xl text-muted-foreground'>
        这里放我做过的项目：一句话说清它是什么、我负责哪一段、关键取舍是什么、现在是什么状态。一篇讲不完的会拆成几篇，从总览进去逐篇读。想看我拆别人的产品，去
        <a href='/product' class='underline underline-offset-4'>产品</a>；想看我最近在想什么，去 <a
          href='/blog'
          class='underline underline-offset-4'>技术</a
        >。
      </p>
    </div>

    {
      groups.map((group) => (
        <section class='mt-12 animate' aria-labelledby={`group-${group.status}`}>
          <div class='mb-4 flex items-baseline gap-3'>
            <h2 id={`group-${group.status}`} class='text-lg font-semibold'>
              {STATUS_LABELS[group.status as ProjectStatus]}
            </h2>
            <span class='text-xs text-muted-foreground'>
              {group.cards.length} 个 · {group.note}
            </span>
          </div>

          <ul class='grid gap-4 sm:grid-cols-2'>
            {group.cards.map((project) => (
              <li class='min-w-0'>
                <ProjectCard {project} />
              </li>
            ))}
          </ul>
        </section>
      ))
    }

    {cards.length === 0 && <p class='mt-12'>还没有项目记录。</p>}

    <div class='mt-12 flex flex-wrap items-center gap-3 border-t border-border pt-6'>
      <Button title='GitHub' class='w-fit' href='https://github.com/b00ml' style='ahead' />
      <p class='text-sm text-muted-foreground'>代码大多在这里；没开源的，文里会说明为什么。</p>
    </div>
  </main>
</PageLayout>
