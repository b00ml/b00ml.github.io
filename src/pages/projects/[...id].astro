---
import { getCollection, render, type CollectionEntry } from 'astro:content'
import { isProjectRoot, projectPath, projectRootId } from '@/lib/projects/entries'
import { STATUS_LABELS, type ProjectStatus } from '@/lib/projects/status'
import { detailAvailable } from '@/lib/seo/drafts'
import { contentLastModified } from '@/lib/seo/lastmod'

import PageLayout from '@/layouts/ContentLayout.astro'
import JsonLd from '@/components/JsonLd.astro'
import MediumZoom from '@/components/MediumZoom.astro'
import ProjectNav from '@/components/navigation/ProjectNav.astro'
import TableOfContents from '@/components/navigation/TableOfContents.astro'
import { integ } from '@/site-config'

/**
 * Project detail - /projects/<slug> and /projects/<slug>/<part>
 * One page per built thing, plus the pages of projects that need more than one.
 * Differs from a post in one place only: the header carries the project's state,
 * scope and evidence links before any prose, so a reader knows what they are
 * looking at without scrolling. Sub-pages inherit that state from their overview
 * instead of repeating it.
 */
export const prerender = true

export async function getStaticPaths() {
  const entries = await getCollection('projects')
  return entries
    .filter((entry) =>
      detailAvailable(entry.data.draft, import.meta.env.DRAFT_PREVIEW, import.meta.env.DEV)
    )
    .map((entry) => ({
      params: { id: projectPath(entry) },
      props: { entry }
    }))
}

type Props = {
  entry: CollectionEntry<'projects'>
}

const { entry } = Astro.props
const { Content, headings } = await render(entry)
const tocHeadings = headings.filter(({ depth }) => depth <= 3)

const all = (await getCollection('projects')).filter((item) => !item.data.draft)
const isRoot = isProjectRoot(entry)
const rootId = projectRootId(entry)
const project = isRoot
  ? entry
  : all.find((item) => isProjectRoot(item) && projectRootId(item) === rootId)
const pages = all
  .filter((item) => !isProjectRoot(item) && projectRootId(item) === rootId)
  .sort((a, b) => a.data.order - b.data.order)

const { title, description, pubDate, updatedDate, role, period, stack, links } = entry.data
const { status = 'shipped' } = project?.data ?? {}
const statusLabel = STATUS_LABELS[status as ProjectStatus]

const dateModified = contentLastModified(entry.filePath, pubDate, updatedDate)
const meta = {
  title: isRoot ? title : `${title} · ${project?.data.title ?? '项目'}`,
  description: description || title,
  noindex: entry.data.draft,
  articleDate: pubDate.toISOString(),
  articleModified: dateModified
}

const origin = Astro.site!.origin
const pageUrl = new URL(Astro.url.pathname, Astro.site).href
const entryLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  '@id': `${pageUrl}#project`,
  mainEntityOfPage: pageUrl,
  name: meta.title,
  ...(description ? { description } : {}),
  inLanguage: 'zh-CN',
  datePublished: pubDate.toISOString(),
  dateModified,
  ...(stack.length ? { keywords: stack } : {}),
  author: { '@id': `${origin}/#person` }
}
const breadcrumbItems = [
  { name: '首页', item: `${origin}/` },
  { name: '项目', item: `${origin}/projects` },
  ...(isRoot
    ? [{ name: title, item: `${origin}/projects/${rootId}` }]
    : [
        { name: project?.data.title ?? rootId, item: `${origin}/projects/${rootId}` },
        { name: title, item: pageUrl }
      ])
]
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    ...item
  }))
}

/**
 * The project's own pages, in the sidebar so the reader can jump sideways
 * without leaving the text. The overview leads, every page links back to it.
 */
const projectPages = [
  {
    href: `/projects/${rootId}`,
    title: project?.data.title ?? rootId,
    summary: '总览',
    current: isRoot
  },
  ...pages.map((item) => ({
    href: `/projects/${projectPath(item)}`,
    title: item.data.title,
    summary: item.data.summary,
    current: item.id === entry.id
  }))
]

/** The way back out, kept at the bottom where the reader ends up. */
const siblings = isRoot
  ? pages.map((item) => ({
      href: `/projects/${projectPath(item)}`,
      title: item.data.title,
      summary: item.data.summary,
      current: false
    }))
  : []
---

<PageLayout {meta} back={isRoot ? '/projects' : `/projects/${rootId}`}>
  <JsonLd schema={[entryLd, breadcrumbLd]} />
  {!!tocHeadings.length && <TableOfContents headings={tocHeadings} slot='sidebar' />}
  <ProjectNav items={projectPages} slot='sidebar' />
  <div slot='header' class='animate gap-y-4'>
    {
      isRoot ? (
        <>
          <div class='mb-3 flex flex-wrap items-center gap-2 text-xs text-muted-foreground'>
            <span class='rounded-md bg-muted px-2 py-1 text-foreground'>{statusLabel}</span>
            {period && <span>{period}</span>}
            {role && <span>· {role}</span>}
          </div>

          <h1 class='mb-4 text-3xl font-bold leading-tight sm:text-4xl'>{title}</h1>
          {description && <p class='text-lg text-muted-foreground'>{description}</p>}

          {stack.length > 0 && (
            <div class='mt-4 flex flex-wrap gap-2 text-xs text-muted-foreground'>
              {stack.map((item: string) => (
                <span class='rounded-md border border-border px-2 py-1'>{item}</span>
              ))}
            </div>
          )}

          {links.length > 0 && (
            <div class='mt-4 flex flex-wrap gap-3'>
              {links.map((link: { label: string; href: string }) => (
                <a
                  href={link.href}
                  target='_blank'
                  rel='noopener noreferrer'
                  class='rounded-md border border-border px-3 py-1.5 text-sm hover:border-foreground/20'
                >
                  {link.label} ↗
                </a>
              ))}
            </div>
          )}
        </>
      ) : (
        <>
          <div class='mb-3 flex flex-wrap items-center gap-2 text-xs text-muted-foreground'>
            <a href={`/projects/${rootId}`} class='underline underline-offset-4'>
              {project?.data.title ?? rootId}
            </a>
            <span>·</span>
            <span>{statusLabel}</span>
            <span>·</span>
            <span>共 {pages.length + 1} 篇</span>
          </div>

          <h1 class='mb-4 text-3xl font-bold leading-tight sm:text-4xl'>{title}</h1>
          {description && <p class='text-lg text-muted-foreground'>{description}</p>}
        </>
      )
    }
  </div>

  <article data-pagefind-body class='prose prose-pure dark:prose-invert max-w-none'>
    <Content />
  </article>

  <div slot='bottom' class='animate mt-10 border-t border-border pt-6'>
    <div class='flex flex-wrap items-center justify-between gap-3'>
      <p class='text-sm text-muted-foreground'>
        {isRoot ? `这个项目分 ${pages.length + 1} 篇讲` : '这一篇讲的是整个项目的一段'}
      </p>
      <a
        href='/projects'
        class='rounded-md border border-border px-3 py-1.5 text-sm hover:border-foreground/20'
      >
        全部项目
      </a>
    </div>

    {
      siblings.length > 0 && (
        <p class='mt-3 text-sm text-muted-foreground'>
          这个项目分 {siblings.length + 1} 篇讲，另外几篇：
        </p>
      )
    }
    {
      siblings.length > 0 && (
        <ul class='mt-4 grid gap-2 sm:grid-cols-2'>
          {siblings.map((item) => (
            <li>
              <a
                href={item.href}
                class='flex h-full flex-col gap-0.5 rounded-lg border border-border px-4 py-3 text-sm transition hover:border-foreground/20'
              >
                <span class='font-medium'>{item.title}</span>
                {item.summary && <span class='text-xs text-muted-foreground'>{item.summary}</span>}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</PageLayout>

{integ.mediumZoom.enable && <MediumZoom />}
