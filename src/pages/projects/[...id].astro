---
import { getCollection, render, type CollectionEntry } from 'astro:content'

import PageLayout from '@/layouts/ContentLayout.astro'
import JsonLd from '@/components/JsonLd.astro'
import { contentLastModified } from '@/lib/seo/lastmod'
import { detailAvailable } from '@/lib/seo/drafts'
import { STATUS_LABELS, type ProjectStatus } from '@/lib/projects/status'

/**
 * Project detail - /projects/<slug>
 * One page per built thing. Differs from a post in one place only: the header
 * carries the project's state, scope and evidence links before any prose, so a
 * reader knows what they are looking at without scrolling.
 */
export const prerender = true

export async function getStaticPaths() {
  const entries = await getCollection('projects')
  return entries
    .filter((entry) =>
      detailAvailable(entry.data.draft, import.meta.env.DRAFT_PREVIEW, import.meta.env.DEV)
    )
    .map((entry) => ({
      params: { id: entry.id },
      props: { entry }
    }))
}

type Props = {
  entry: CollectionEntry<'projects'>
}

const { entry } = Astro.props
const { Content } = await render(entry)

const { title, description, pubDate, updatedDate, status, role, period, stack, links } = entry.data
const statusLabel = STATUS_LABELS[status as ProjectStatus]

const dateModified = contentLastModified(entry.filePath, pubDate, updatedDate)
const meta = {
  title,
  description: description || title,
  noindex: entry.data.draft,
  articleDate: pubDate.toISOString(),
  articleModified: dateModified
}

const origin = Astro.site!.origin
const pageUrl = new URL(Astro.url.pathname, Astro.site).href
const entryLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  '@id': `${pageUrl}#project`,
  mainEntityOfPage: pageUrl,
  name: title,
  ...(description ? { description } : {}),
  inLanguage: 'zh-CN',
  datePublished: pubDate.toISOString(),
  dateModified,
  ...(stack.length ? { keywords: stack } : {}),
  author: { '@id': `${origin}/#person` }
}
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首页', item: `${origin}/` },
    { '@type': 'ListItem', position: 2, name: '项目', item: `${origin}/projects` },
    { '@type': 'ListItem', position: 3, name: title }
  ]
}
---

<PageLayout {meta} back='/projects'>
  <JsonLd schema={[entryLd, breadcrumbLd]} />
  <div slot='header' class='animate gap-y-4'>
    <div class='mb-3 flex flex-wrap items-center gap-2 text-xs text-muted-foreground'>
      <span class='rounded-md bg-muted px-2 py-1 text-foreground'>{statusLabel}</span>
      {period && <span>{period}</span>}
      {role && <span>· {role}</span>}
    </div>

    <h1 class='mb-4 text-3xl font-bold leading-tight sm:text-4xl'>{title}</h1>
    {description && <p class='text-lg text-muted-foreground'>{description}</p>}

    {
      stack.length > 0 && (
        <div class='mt-4 flex flex-wrap gap-2 text-xs text-muted-foreground'>
          {stack.map((item: string) => (
            <span class='rounded-md border border-border px-2 py-1'>{item}</span>
          ))}
        </div>
      )
    }

    {
      links.length > 0 && (
        <div class='mt-4 flex flex-wrap gap-3'>
          {links.map((link: { label: string; href: string }) => (
            <a
              href={link.href}
              target='_blank'
              rel='noopener noreferrer'
              class='rounded-md border border-border px-3 py-1.5 text-sm hover:border-foreground/20'
            >
              {link.label} ↗
            </a>
          ))}
        </div>
      )
    }
  </div>

  <article data-pagefind-body class='prose prose-pure dark:prose-invert max-w-none'>
    <Content />
  </article>

  <div slot='bottom' class='animate mt-8 flex justify-end border-t border-border pt-6'>
    <a
      href='/projects'
      class='rounded-md border border-border px-3 py-1.5 text-sm hover:border-foreground/20'
    >
      全部项目
    </a>
  </div>
</PageLayout>
