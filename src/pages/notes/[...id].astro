---
import { getCollection, render, type CollectionEntry } from 'astro:content'
import { detailAvailable } from '@/lib/seo/drafts'
import { contentLastModified } from '@/lib/seo/lastmod'

import { Button, Icon } from 'astro-pure/user'
import PageLayout from '@/layouts/ContentLayout.astro'
import JsonLd from '@/components/JsonLd.astro'
import TableOfContents from '@/components/navigation/TableOfContents.astro'

export const prerender = true

export async function getStaticPaths() {
  const notes = await getCollection('notes')
  return notes
    .filter((entry) =>
      detailAvailable(entry.data.draft, import.meta.env.DRAFT_PREVIEW, import.meta.env.DEV)
    )
    .map((entry) => ({
      params: { id: entry.id },
      props: { entry }
    }))
}

type Props = {
  entry: CollectionEntry<'notes'>
}

const { entry } = Astro.props
const { Content, headings } = await render(entry)
const tocHeadings = headings.filter(({ depth }) => depth <= 3)

const { title, description, pubDate, updatedDate, tags } = entry.data

const dateModified = contentLastModified(entry.filePath, pubDate, updatedDate)
const meta = {
  title,
  description: description || title,
  noindex: entry.data.draft,
  articleDate: pubDate.toISOString(),
  articleModified: dateModified
}

// Structured data：BlogPosting + 面包屑；author/publisher 引用 BaseHead 里全站输出的 Person
const origin = Astro.site!.origin
const pageUrl = new URL(Astro.url.pathname, Astro.site).href
const noteLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${pageUrl}#article`,
  mainEntityOfPage: pageUrl,
  headline: title,
  ...(description ? { description } : {}),
  inLanguage: 'zh-CN',
  datePublished: pubDate.toISOString(),
  dateModified,
  ...(tags.length ? { keywords: tags } : {}),
  author: { '@id': `${origin}/#person` },
  publisher: { '@id': `${origin}/#person` },
  isPartOf: { '@id': `${origin}/#website` }
}
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首页', item: `${origin}/` },
    { '@type': 'ListItem', position: 2, name: 'Notes', item: `${origin}/notes` },
    { '@type': 'ListItem', position: 3, name: title }
  ]
}
---

<PageLayout {meta} back='/notes'>
  <JsonLd schema={[noteLd, breadcrumbLd]} />
  {!!tocHeadings.length && <TableOfContents headings={tocHeadings} slot='sidebar' />}
  <div slot='header' class='animate gap-y-4'>
    {
      tags.length > 0 && (
        <div class='mb-2 flex flex-wrap items-center gap-2 text-sm text-muted-foreground'>
          {tags.map((tag) => (
            <a
              href={`/notes/tags/${tag}`}
              class='rounded-md border border-border px-2 py-1 transition hover:border-foreground/20'
            >
              {tag}
            </a>
          ))}
        </div>
      )
    }

    <h1 class='mb-4 text-3xl font-bold leading-tight sm:text-4xl'>{title}</h1>

    {description && <p class='text-lg text-muted-foreground'>{description}</p>}

    <div class='mt-4 flex flex-wrap items-center gap-4 text-sm text-muted-foreground'>
      <div class='flex items-center gap-2'>
        <Icon name='calendar' />
        <time datetime={pubDate.toISOString()}>
          {
            pubDate.toLocaleDateString('zh-CN', {
              year: 'numeric',
              month: 'long',
              day: 'numeric'
            })
          }
        </time>
      </div>
      {
        updatedDate && (
          <div class='flex items-center gap-2'>
            <Icon name='calendar' />
            <span>
              Updated{' '}
              {updatedDate.toLocaleDateString('zh-CN', {
                year: 'numeric',
                month: 'long',
                day: 'numeric'
              })}
            </span>
          </div>
        )
      }
    </div>
  </div>

  <article data-pagefind-body class='prose prose-pure dark:prose-invert max-w-none'>
    <Content />
  </article>

  <div slot='bottom' class='animate mt-8 border-t border-border pt-6'>
    <div class='flex items-start justify-between gap-4'>
      <p class='text-xs text-muted-foreground'>内容可能还没写完，会持续补充。</p>
      <Button title='Back' href='/notes' style='back' />
    </div>
  </div>
</PageLayout>
