---
import PFSearch from '@/components/pure/PFSearch.astro'
import { Button } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'

const meta = {
  description: 'Search across every post, note and product write-up',
  noindex: true,
  title: 'Search'
}
---

<PageLayout {meta}>
  <Button title='Back' href='/' style='back' />
  <main class='mt-6 lg:mt-10'>
    <div id='content-header' class='animate'>
      <h1 class='mb-6 text-3xl font-medium'>Search</h1>
    </div>

    <div id='content' class='animate'>
      <PFSearch />
    </div>
  </main>
</PageLayout>
