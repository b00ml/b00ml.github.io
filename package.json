{
  "name": "peik1-blog",
  "type": "module",
  "version": "0.1.0",
  "packageManager": "bun@1.3.10",
  "scripts": {
    "dev": "astro dev",
    "test": "bun test src/",
    "dev:check": "astro check --watch & astro dev",
    "build": "node scripts/clean-content-cache.mjs && astro build && bun run --cwd apps/finance-demo build",
    "build:checked": "bun run check && bun run build",
    "publish": "node scripts/publish.mjs",
    "ingest": "node scripts/ingest.mjs",
    "preview": "astro preview",
    "sync": "astro sync",
    "check": "astro-pure check && astro check",
    "astro": "astro",
    "pure": "astro-pure",
    "new": "astro-pure new",
    "format": "prettier --write  '**/*.{js,jsx,ts,tsx,md,mdx,astro}'",
    "lint": "eslint --fix 'src/**/*.{js,ts,jsx,tsx,astro}'",
    "yijiansilian": "bun lint && bun sync && bun check && bun format",
    "clean": "rm -rf .astro dist node_modules/.astro",
    "demo:dev": "bun run --cwd apps/finance-demo dev",
    "demo:test": "bun run --cwd apps/finance-demo test"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/rss": "^4.0.11",
    "@astrojs/sitemap": "^3.4.1",
    "@unocss/preset-wind3": "^66.1.3",
    "@unocss/reset": "^66.1.3",
    "astro": "^5.8.1",
    "astro-pure": "1.3.0",
    "katex": "^0.16.22",
    "rehype-katex": "^7.0.1",
    "remark-cjk-friendly": "^2.3.1",
    "remark-math": "^6.0.0",
    "remark-mdx": "^3.1.0",
    "sharp": "^0.34.2",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.4.2",
    "eslint": "^9.28.0",
    "eslint-plugin-astro": "^1.3.1",
    "pagefind": "^1.3.0",
    "prettier": "^3.5.3",
    "prettier-plugin-astro": "^0.14.1",
    "typescript-eslint": "^8.33.0"
  }
}
